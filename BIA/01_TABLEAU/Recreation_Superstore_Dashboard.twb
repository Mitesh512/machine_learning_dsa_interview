      <column caption='Profit Ratio' datatype='real' datatype-customized='true' default-format='p0.00%' name='[Calculation_2794272517519601664]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Profit]) / sum([Sales])' />
      </column>
      <column caption='Sales Per Customer' datatype='real' name='[Calculation_2794272517519847425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Sales])/COUNTD([Customer Name])' />
      </column>
      <column caption='Order Profitable ?' datatype='boolean' name='[Calculation_2794272517523656706]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED [Order ID]: SUM([Profit]) } &gt; 0' />
      </column>
      <column caption='Profit Per Order' datatype='real' name='[Calculation_2794272517528391683]' role='measure' type='quantitative'>
